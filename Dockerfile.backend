FROM golang:1.22-alpine AS builder
RUN apk add --no-cache gcc musl-dev
WORKDIR /app
COPY go.mod go.sum ./
# Модуль лицензирования хранится вне репозитория и кладётся сюда при деплое
COPY _private ./_private
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -o /pm-dashboard .

FROM alpine:3.19
# tzdata: сервер ведёт расписания и дни истории в часовом поясе из TZ.
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /pm-dashboard /usr/local/bin/
COPY --from=builder /app/invoice /app/invoice
# Файлы миграций должны быть в образе; иначе RunMigrations переходит на
# встроенный SQL, и будущие NNN_*.up.sql не применяются.
COPY --from=builder /app/db/migrations /app/db/migrations
WORKDIR /app
RUN mkdir -p /data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:8080/api/setup/status || exit 1
CMD ["pm-dashboard"]
