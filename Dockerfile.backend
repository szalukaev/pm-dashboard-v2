FROM golang:1.22-alpine AS builder
RUN apk add --no-cache gcc musl-dev
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -o /pm-dashboard .

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
COPY --from=builder /pm-dashboard /usr/local/bin/
COPY --from=builder /app/invoice /app/invoice
RUN mkdir -p /data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://localhost:8080/api/setup/status || exit 1
CMD ["pm-dashboard"]
