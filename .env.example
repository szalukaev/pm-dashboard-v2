# ═══════════════════════════════════════════════════════
# PM Dashboard V3 — Environment
# DB credentials, Redmine API key — настраиваются через Setup Wizard
# и хранятся в SQLite (/data/config.db)
# ═══════════════════════════════════════════════════════

APP_PORT=8080
DATA_DIR=/data

# Пароль Redis (обязателен — Redis не публикуется наружу)
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0

# Secure-флаг сессионной куки (true при работе за HTTPS)
SECURE_COOKIES=false

# Разрешённый Origin для WebSocket/CORS (дополнительно к localhost:82 и :5173)
# FRONTEND_ORIGIN=https://pm.example.com
